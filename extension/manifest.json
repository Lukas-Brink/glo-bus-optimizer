{
  "manifest_version": 3,
  "name": "GloBus-Pilot: Strategy & Decision Optimizer",
  "version": "2.2.0",
  "description": "Autonomous multi-objective decision optimizer and simulation HUD for GLO-BUS (Action Cameras & UAV Drones).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GloBus-Pilot Optimizer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.glo-bus.com/*",
        "*://glo-bus.com/*"
      ],
      "js": [
        "dom-adapter.js",
        "scoring-kernel.js",
        "capacity-kernel.js",
        "star-solver.js",
        "optimizer.js",
        "page-coordinator.js",
        "hud.js"
      ],
      "css": [
        "hud.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.glo-bus.com/*",
    "*://glo-bus.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "globus-pilot@optimizer.local",
      "strict_min_version": "109.0"
    }
  }
}
